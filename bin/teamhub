#!/usr/bin/env bash
# bin/teamhub – entry-point wrapper for the TeamHub live dashboard server.
# Serves an HTTP dashboard summarizing turnin, commit, and HSD activity for
# a manager's team across the GFC and JNC projects.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

exec python3 "${REPO_ROOT}/tools/teamhub/dashboard_server.py" "$@"
